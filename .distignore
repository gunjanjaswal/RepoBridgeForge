# Files and folders that should NOT ship to the WordPress.org plugin build.
# Everything not listed here is included, so the runtime code always ships.

/.git
/.github
/.gitignore
/.distignore
/.editorconfig

# Dev docs (WordPress.org uses readme.txt, not these)
/README.md
/CHANGELOG.md
/CONTRIBUTING.md

# Store assets (icon, banner) go to a separate SVN path, not the plugin build
/.wordpress-org
/assets

# Tooling
/node_modules
/vendor/bin
/tests
composer.json
composer.lock
phpcs.xml
phpcs.xml.dist
package.json
package-lock.json

# Misc
*.zip
*.log
.DS_Store
